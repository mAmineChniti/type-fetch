{
	"name": "@thatguyjamal/type-fetch",
	"version": "1.0.0",
	"description": "A lightweight, zero-dependency HTTP client library for making API requests in JavaScript/TypeScript.",
	"repository": {
		"type": "git",
		"url": "https://github.com/thatguyjamal/type-fetch.git"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": ["dist", "README.md", "LICENSE"],
	"scripts": {
		"build": "tsc -p ./tsconfig.build.json && tsc-alias -p ./tsconfig.json",
		"ts:init": "tsc --init",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"test": "jest"
	},
	"keywords": ["http", "client", "typescript", "library", "request", "fetch"],
	"author": "Jamal Lyons",
	"license": "MIT",
	"sideEffects": false,
	"engines": {
		"node": ">=14.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@jest/types": "^29.6.3",
		"@types/jest": "^29.5.12",
		"@types/node": "22.13.14",
		"jest": "^29.7.0",
		"ts-jest": "29.3.0",
		"ts-node": "^10.9.2",
		"tsc-alias": "1.8.13",
		"tsconfig-paths-webpack-plugin": "4.2.0",
		"typescript": "5.8.2"
	},
	"packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
